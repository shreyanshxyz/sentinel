PORT=8000
HOST=0.0.0.0
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
MAX_LOGS_IN_MEMORY=10000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
SSE_HEARTBEAT_INTERVAL_MS=30000

WORKER_BASE_URL=http://localhost:8080
ENABLE_STREAMING=true
WORKER_TIMEOUT=120

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sentinel
DATABASE_USER=sentinel
DATABASE_PASSWORD=sentinel_password
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=false

LOG_RETENTION_DAYS=30
LOG_COMPRESSION_DAYS=7
